# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth / Session Secret
SESSION_SECRET="generate-a-secure-random-secret-at-least-32-chars"

# Super admin — only this account can permanently delete users that have activity history
SUPER_ADMIN_EMAIL="sowmentopu@gmail.com"

# Email (SMTP via Nodemailer) — set EMAIL_ENABLED=true once SMTP is configured
# Gmail example: host=smtp.gmail.com, port=465, secure=true, user=<gmail>, pass=<App Password>
EMAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Army Leave Management <no-reply@army.local>"
